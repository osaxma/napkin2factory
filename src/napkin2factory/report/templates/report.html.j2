<!doctype html>
<html lang="en" data-persona="{{ persona }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ product.name }} — napkin2factory report</title>
{{ n2f_favicon }}
<style>
:root{--bg:#f7f6f2;--fg:#1d1d1b;--muted:#6b6a66;--line:#d9d7d0;--card:#fff;--ok:#1a7344;--fail:#b3261e;--warn:#8a6000;--human:#7a3e9d;--signed:#0b6e8f;--skip:#6a6a6a;--accent:#1f5fbf;--hl:#fff6d6;--head-h:140px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:calc(var(--head-h) + 12px)}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
a{color:var(--accent)}a.ref{text-decoration:none;border-bottom:1px dotted currentColor}a.ref:hover{border-bottom-style:solid}
/* keyboard, screen readers and contrast (M4, S-325): one focus ring for everything; .sr is for words that only a screen reader needs;
   the status colours are dark enough for white text and for text on the page's tints (WCAG AA, 4.5:1) */
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.sr{position:absolute !important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
.skip-link{position:absolute;z-index:40;left:.6rem;top:-4rem;padding:.5rem .9rem;background:#fff;color:var(--accent);border:2px solid var(--accent);border-radius:8px;font-weight:600;text-decoration:none}
.skip-link:focus,.skip-link:focus-visible{top:.6rem}
.badge{display:inline-block;padding:.1rem .55rem;border-radius:999px;font-size:.78rem;font-weight:600;color:#fff;background:var(--skip);white-space:nowrap}
.badge.pass,.badge.ok{background:var(--ok)}.badge.fail{background:var(--fail)}.badge.warn{background:var(--warn)}.badge.needs-human{background:var(--human)}.badge.signed{background:var(--signed)}.badge.skip{background:var(--skip)}
section.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.2rem}
section.card h2{margin:.2rem 0 .8rem;font-size:1.1rem;display:flex;align-items:baseline;gap:.5rem}
h2 a.anchor{color:var(--line);text-decoration:none;font-weight:400}h2:hover a.anchor,h2 a.anchor:focus-visible{color:var(--accent)}
h3{font-size:.95rem;margin:1.2rem 0 .5rem}
.lead{margin:0 0 .8rem;color:var(--muted);font-size:.9rem}
.safety{border-color:#e4a3a0;background:#fff7f6}
table{border-collapse:collapse;width:100%;font-size:.9rem}th,td{border-bottom:1px solid var(--line);padding:.35rem .5rem;text-align:left;vertical-align:top}th{background:#f1f0eb;font-weight:600}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr:target>td,tr:target>th,.row-hl>td{background:var(--hl)}
tr[id],details[id],figure[id]{scroll-margin-top:calc(var(--head-h) + 12px)}
.scroll{overflow:auto;max-width:100%}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem}
figure{margin:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}figure svg{width:100%;height:auto;display:block;cursor:zoom-in}figcaption{padding:.4rem .6rem;font-size:.85rem;color:var(--muted);border-top:1px solid var(--line)}
figure.zoom{grid-column:1 / -1}figure.zoom svg{cursor:zoom-out}
.muted{color:var(--muted)}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85em}.small{font-size:.85rem}
.example{display:inline-block;background:#ffe9a8;color:#5a4300;border:1px solid #e6c34a;border-radius:4px;padding:0 .4rem;font-size:.75rem;font-weight:700;letter-spacing:.04em}
.matrix{font-size:.8rem}.matrix th,.matrix td{padding:.25rem .35rem}
.matrix th.part{writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;text-align:left;font-weight:500;padding:.5rem .2rem}
.matrix th.part a{color:inherit;text-decoration:none}
.matrix td.rule,.matrix th.rule{position:sticky;left:0;background:#fff;min-width:260px;z-index:1}.matrix thead th.rule{background:#f1f0eb}.matrix tbody th.rule{font-weight:400}
.matrix td.cell{text-align:center}
tr.module th{background:#f1f0eb;text-align:left;font-weight:600}.matrix th.module{font-size:.72rem;font-weight:500;text-align:left;border-left:1px solid #ddd;white-space:normal}
.dot{display:inline-block;width:.85rem;height:.85rem;border-radius:50%;background:var(--skip);vertical-align:middle}
.dot.pass{background:var(--ok)}.dot.fail{background:var(--fail)}.dot.warn{background:var(--warn)}.dot.needs-human{background:var(--human)}.dot.signed{background:var(--signed)}
.legend{display:flex;gap:1rem;flex-wrap:wrap;font-size:.82rem;color:var(--muted);margin:.4rem 0}
.doc{font-size:.95rem}.doc h1{font-size:1.1rem}.doc h2{font-size:1rem}.doc h3{font-size:.95rem}
details summary{cursor:pointer;font-weight:600}details{padding:.3rem 0;border-bottom:1px solid var(--line)}details:last-child{border-bottom:0}
.kv{display:grid;grid-template-columns:max-content 1fr;gap:.3rem 1rem;font-size:.9rem}
.next{font-size:1rem;padding:.5rem .8rem;background:#eef4ff;border:1px solid #c9d8f5;border-radius:8px;margin:.8rem 0 0}
.filter{font-size:.85rem;color:var(--muted);margin:0 0 .5rem}
.wrap{word-break:break-word}#req-table td.req{min-width:220px}#req-table td:nth-child(4){min-width:150px}#req-table td:last-child{min-width:200px}
table.only-open tr.st-pass,table.only-open tr.st-signed{display:none}
.actions a{margin-right:.5rem;white-space:nowrap}
.step{border-top:1px solid var(--line);padding-top:.4rem;margin-top:.8rem}.step:first-of-type{border-top:0;margin-top:0}.step h3{margin-top:.4rem}
.stepgrid{display:grid;grid-template-columns:minmax(240px,1fr) minmax(0,2fr);gap:1rem;align-items:start}.stepgrid figure.zoom{grid-column:1 / -1}
/* the workbench page (v0.9 M3a, V2): a sticky top bar, five lenses, the workbench lens in three panes */
header.top{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--line);padding:.7rem 1.1rem 0}
header.top .row{display:flex;gap:.6rem 1rem;align-items:center;flex-wrap:wrap}
header.top h1{font-size:1.15rem;margin:0}
header.top .vitals{margin-top:.25rem;gap:.2rem 1.2rem}
.vital b{font-weight:600}.vital .muted{font-size:.82rem;margin-left:.25rem}
header.top .counts{display:block;margin-top:.1rem;font-size:.85rem}
header.top .counts a,header.top .vitals a{color:inherit;text-decoration:none}header.top .counts a:hover,header.top .vitals a:hover{text-decoration:underline}
.tabs{display:flex;gap:.2rem;margin-top:.5rem}
.tabs button{font:inherit;font-size:.92rem;background:none;border:0;border-bottom:3px solid transparent;padding:.45rem .9rem .35rem;color:var(--muted);cursor:pointer}
.tabs button:hover{color:var(--fg)}.tabs button[aria-selected=true]{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.lens[hidden]{display:none}
.cards{max-width:1440px;margin:0 auto;padding:1rem 1.2rem 2rem;display:flex;flex-direction:column;gap:1.2rem}
.cards:empty{display:none}
main footer{padding:.5rem 1.2rem 2rem;max-width:1440px;margin:0 auto}
.wb{display:grid;grid-template-columns:260px minmax(0,1fr) 380px;height:calc(100vh - var(--head-h));min-height:440px;background:#fff;border-bottom:1px solid var(--line)}
.wb>*{min-height:0;min-width:0}
nav.tree{overflow:auto;padding:.6rem .5rem 1rem;border-right:1px solid var(--line);font-size:.9rem}
nav.tree ul{list-style:none;margin:0;padding:0}nav.tree ul ul{padding-left:.9rem}
nav.tree li{margin:0}
nav.tree .row{display:flex;align-items:center;gap:.15rem;border-left:3px solid transparent;border-radius:6px;padding:.18rem .3rem;cursor:pointer}
nav.tree .row:hover{background:#efeee8}
nav.tree li[aria-selected=true]>.row{background:#e8f0fe;border-left-color:var(--accent);color:var(--accent)}
nav.tree .tog{width:1rem;flex:none;color:var(--muted);font-size:.7rem;text-align:center}
nav.tree .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
nav.tree .qty,nav.tree .sub{color:var(--muted);font-size:.8rem;white-space:nowrap}
nav.tree li.head>.row{font-weight:600}nav.tree li.group>.row{color:var(--muted)}
nav.tree li:focus{outline:none}nav.tree li:focus>.row{outline:2px solid var(--accent);outline-offset:-2px}  /* the row carries the ring, not the whole li with its children */
.pane3d:focus-visible,.pane3d .viewer:focus-visible{outline-offset:-3px}
nav.tree li[aria-expanded=false]>ul{display:none}
.pane3d{position:relative;background:#f4f4f2;display:flex;flex-direction:column;min-height:0}
.pane3d .viewer{flex:1 1 0;min-height:0;position:relative;overflow:hidden}.pane3d .viewer canvas{display:block}.pane3d .viewer.n2f-active{outline:2px solid var(--accent);outline-offset:-2px}
.pane3d .none{margin:4rem 1rem}
.toolbar3d{position:absolute;z-index:2;top:.6rem;left:.6rem;right:.6rem;display:flex;gap:.5rem 1rem;align-items:center;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:8px;padding:.35rem .6rem;font-size:.85rem}
.toolbar3d label{display:inline-flex;gap:.35rem;align-items:center}
.toolbar3d input[type=range]{width:110px}
.toolbar3d button{font:inherit;font-size:.85rem;background:#fff;border:1px solid var(--line);border-radius:6px;padding:.15rem .6rem;cursor:pointer}
.toolbar3d button:hover{border-color:var(--accent)}
.secgrp{display:inline-flex;gap:.4rem;align-items:center}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{border:0;border-radius:0;padding:.15rem .55rem}.seg button[aria-pressed=true]{background:var(--accent);color:#fff}
.help3d{position:absolute;z-index:1;left:.8rem;bottom:.5rem;margin:0;font-size:.8rem;color:var(--muted);pointer-events:none}
.pane3d.off .toolbar3d{display:none}
.insp{overflow:auto;border-left:1px solid var(--line);padding:.8rem 1rem 2rem}
#inspector-head .kindline{font-size:.82rem;color:var(--muted)}
/* an address like part://… is for the engineer persona; the text stays in the page for deep links (N5, S-325) */
html:not([data-persona="engineer"]) #inspector-head .addr{display:none}
#inspector-head h2{margin:.15rem 0 .4rem;font-size:1.2rem;overflow-wrap:anywhere}
.insp a{text-decoration:none}.insp a:hover{text-decoration:underline}
.insp .btns{display:flex;gap:.4rem;margin:.4rem 0 .8rem;flex-wrap:wrap}
.insp .btns button{font:inherit;font-size:.85rem;background:#fff;border:1px solid var(--line);border-radius:6px;padding:.2rem .7rem;cursor:pointer}
.insp .btns button:hover{border-color:var(--accent)}
.pane3d.off~.insp .btns .need3d{display:none}
.insp h3{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:1.2rem 0 .4rem}
#inspector-product h3{text-transform:none;letter-spacing:0;font-size:.95rem;color:var(--fg);margin:1rem 0 .4rem}
.insp .kv .k{color:var(--muted)}.insp .kv .v .muted{font-size:.82rem;margin-left:.3rem}
.insp ul.links{list-style:none;margin:0;padding:0}.insp ul.links li{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* the list clips long names, which would clip a link's ring: the ring goes on the row instead (S-325) */
@supports selector(:has(a)){.insp ul.links li:has(a:focus-visible){outline:2px solid var(--accent);outline-offset:-2px;border-radius:4px}.insp ul.links a:focus-visible{outline:none}}
.insp table{font-size:.85rem}.insp table td{padding:.25rem .35rem}
.insp .files{display:flex;flex-direction:column;gap:.1rem}
.st-pass,.st-signed{color:var(--ok);font-weight:600}.st-fail{color:var(--fail);font-weight:600}.st-warn{color:var(--warn);font-weight:600}.st-needs-human{color:var(--human);font-weight:600}.st-skip,.st-later{color:var(--muted)}
.insp td.stc{white-space:nowrap}
.product-view .kv{grid-template-columns:max-content minmax(0,1fr)}
@media (max-width:1100px){.wb{grid-template-columns:220px minmax(0,1fr) 320px}}
@media (max-width:960px){
  .matrix td.rule,.matrix th.rule{min-width:180px}
  .stepgrid{display:block}
}
/* phone (V8, M3a): the bar wraps, the lens tabs sit at the bottom; wide tables scroll inside themselves,
   the page never scrolls sideways.  The workbench's own phone layout is the next block (M4) */
@media (max-width:767px){
  :root{--head-h:0px}
  header.top{position:static;padding:.7rem 1rem .6rem}
  .tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;margin:0;background:#fff;border-top:1px solid var(--line);justify-content:space-around;gap:0}
  .tabs button{flex:1 1 0;min-width:0;padding:.7rem .2rem .6rem;font-size:.85rem;border-bottom:0;border-top:3px solid transparent}
  .tabs button[aria-selected=true]{border-top-color:var(--accent)}
  body{padding-bottom:3.4rem}
  .cards{padding:.8rem 1rem 1.5rem}
  main table{display:block;max-width:100%;overflow-x:auto}
  .grid{grid-template-columns:minmax(0,1fr)}
  .kv{grid-template-columns:minmax(0,1fr)}
  .scroll{max-width:100%}
}
/* the details toggle, the dock and the sheet heads exist for the phone only (V8, M4, S-324) */
.hdr-toggle,.dock,.sheet-head{display:none}
/* phone workbench (V8, M4, S-324): the 3D fills the screen, the parts list and the inspector are bottom sheets
   above the tab bar, the view controls a small panel above the dock; one open at a time, `.wb[data-sheet]`.
   `screen` keeps all of it out of the print packet, which a 700 px page would otherwise match */
@media screen and (max-width:767px){
  :root{--tab-h:56px;--dock-h:44px;--hdr-h:96px}
  body{padding-bottom:calc(var(--tab-h) + .5rem)}
  .tabs{height:var(--tab-h)}
  header.top .row:first-child{flex-wrap:nowrap;gap:.5rem}
  header.top h1{flex:0 1 auto;min-width:0;font-size:1.05rem;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow-wrap:anywhere}  /* the name wraps to two lines; the revision waits in Details (S-324) */
  header.top:not(.open) .rev{display:none}
  header.top .rev{flex:0 3 auto;min-width:0;font-size:.78rem;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .badge{flex:none}
  header.top.open .row:first-child{flex-wrap:wrap}
  header.top.open h1{flex:1 1 0;display:block;-webkit-line-clamp:unset}
  header.top.open .hdr-toggle{order:4}
  header.top.open .rev{order:5;flex:1 0 100%;white-space:normal;overflow:visible}  /* the whole state line, once the bar is open */
  .hdr-toggle{display:inline-flex;align-items:center;flex:none;margin-left:auto;min-width:44px;min-height:44px;padding:0 .6rem;font:inherit;font-size:.88rem;color:inherit;background:#fff;border:1px solid var(--line);border-radius:8px;cursor:pointer}
  .hdr-toggle::after{content:"▾";margin-left:.35rem;font-size:.75rem}
  .hdr-toggle[aria-expanded=true]::after{content:"▴"}
  header.top:not(.open) .vitals,header.top:not(.open) .counts{display:none}
  #lens-workbench{padding-bottom:var(--dock-h)}
  .wb{display:block;height:auto;min-height:0;border-bottom:0}
  .pane3d{height:max(320px,calc(100vh - var(--hdr-h) - var(--tab-h)));padding-bottom:var(--dock-h)}
  .pane3d:focus{outline:none}
  .help3d{bottom:calc(var(--dock-h) + .4rem)}
  .dock{display:flex;position:fixed;left:0;right:0;bottom:var(--tab-h);height:var(--dock-h);z-index:26;background:#fff;border-top:1px solid var(--line)}
  .dock button{flex:1 1 0;min-width:0;min-height:44px;display:flex;align-items:center;justify-content:center;gap:.35rem;padding:0 .5rem;font:inherit;font-size:.92rem;color:var(--fg);background:none;border:0;border-right:1px solid var(--line);cursor:pointer}
  .dock button:last-child{border-right:0}
  .dock button[hidden]{display:none}
  .dock button[aria-expanded=true]{color:var(--accent);font-weight:600}
  .dock .lbl{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .dock .up{flex:none;font-size:.75rem;color:var(--muted)}
  /* the sheets: closed = hidden and moved out (not tabbable, not announced); open = shown */
  nav.tree,.insp,.toolbar3d{visibility:hidden;transition:transform .18s ease,opacity .18s ease,visibility 0s linear .18s}
  nav.tree,.insp{position:fixed;left:0;right:0;bottom:var(--tab-h);z-index:28;max-height:70vh;max-height:min(70vh,70dvh);overflow:auto;overscroll-behavior:contain;padding:0 1rem 1.2rem;background:#fff;border:0;border-top:1px solid var(--line);border-radius:14px 14px 0 0;box-shadow:0 -6px 24px rgba(0,0,0,.22);transform:translateY(100%)}
  .wb[data-sheet=tree] nav.tree,.wb[data-sheet=inspector] .insp,.wb[data-sheet=view] .toolbar3d{visibility:visible;transform:none;opacity:1;transition:transform .18s ease,opacity .18s ease,visibility 0s}
  .sheet-head{display:flex;align-items:center;justify-content:space-between;gap:.6rem;position:sticky;top:0;z-index:2;flex:0 0 100%;min-height:52px;margin:0 -1rem;padding:0 .4rem 0 1rem;background:#fff;border-bottom:1px solid var(--line)}
  .sheet-title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:1.05rem;font-weight:600}
  .sheet-close{flex:none;min-width:44px;height:44px;padding:0 .8rem;font:inherit;font-size:.92rem;color:var(--accent);background:none;border:0;border-radius:8px;cursor:pointer}
  #inspector-head h2{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  nav.tree .row{min-height:44px;padding:.18rem .5rem}
  nav.tree .lbl{white-space:normal;overflow-wrap:anywhere}
  nav.tree .tog{width:1.6rem;font-size:.8rem}
  .insp .btns button{min-height:44px;min-width:44px}
  .insp ul.links li{display:flex;flex-wrap:wrap;align-items:center;gap:0 .3rem;min-height:44px;padding:.2rem 0;white-space:normal;overflow:visible}
  /* the 3D controls: a panel above the dock, not over the model */
  .toolbar3d{position:fixed;z-index:27;top:auto;left:.6rem;right:.6rem;bottom:calc(var(--tab-h) + var(--dock-h) + .5rem);max-height:60vh;overflow:auto;padding:0 .9rem .5rem;gap:.1rem 1rem;border-radius:12px;box-shadow:0 -4px 18px rgba(0,0,0,.2);opacity:0;transform:translateY(12px)}
  .toolbar3d .sheet-head{margin:0 -.9rem}
  .toolbar3d label{min-height:44px}
  .toolbar3d>label{flex:1 1 100%}.toolbar3d>label input[type=range]{flex:1}
  .secgrp{flex:1 1 100%;flex-wrap:wrap}
  .toolbar3d input[type=range]{width:auto;min-width:0;flex:1 1 140px;height:44px}
  .toolbar3d input[type=checkbox]{width:22px;height:22px}
  .toolbar3d button{min-width:44px;min-height:44px}
  .seg button{min-width:44px}
  /* the build player's buttons (sections/build.html.j2) get the same size */
  .player button{min-height:44px;min-width:44px}
  @supports (height:100dvh){.pane3d{height:max(320px,calc(100dvh - var(--hdr-h) - var(--tab-h)))}}
}
@media screen and (max-width:767px) and (prefers-reduced-motion:reduce){
  nav.tree,.insp,.toolbar3d{transition:none !important}
}
/* forced colours (Windows high contrast): borders and outlines stay, and what colour told is also said by weight (S-325) */
@media (forced-colors:active){
  :focus-visible{outline:2px solid Highlight}
  .badge,.example,.dot{border:1px solid currentColor;forced-color-adjust:none}
  .dot.pass,.dot.fail,.dot.warn,.dot.needs-human,.dot.signed{border-width:1px}
  nav.tree li[aria-selected=true]>.row{font-weight:700;text-decoration:underline;border-left-color:Highlight}
  .seg button[aria-pressed=true]{font-weight:700;text-decoration:underline;outline:2px solid Highlight;outline-offset:-2px}
  .tabs button[aria-selected=true]{font-weight:700;text-decoration:underline;border-bottom-color:Highlight}
  .toolbar3d button,.insp .btns button,.seg,.dock button,.hdr-toggle{border:1px solid ButtonText}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition:none !important;animation:none !important}
}
{% include "print.css.j2" ignore missing %}
</style>
</head>
<body>
{% macro w(st) -%}{{ words.get(st, st) }}{%- endmacro %}
{% macro badge(st) -%}<span class="badge {{ st }}" title="{{ st }}">{{ w(st) }}</span>{%- endmacro %}
{% macro h2(id, title) -%}<h2 id="h-{{ id }}">{{ title }} <a class="anchor" href="#{{ id }}" title="link to this section" aria-label="Link to {{ title }}">#</a></h2>{%- endmacro %}
{# The page is one workbench (V1, V2): the top bar, then one panel per lens that has a shown section
   (V7: a lens with none gets no tab and no panel). Show/hide stays each section's own `show`. #}
{% set lens_label = {'workbench': 'Workbench', 'drawings': 'Drawings', 'build': 'Build', 'verification': 'Checks', 'history': 'History'} %}
{% set used_lenses = page_sections | map(attribute='lens') | list %}
{% set shown_lenses = lenses | select('in', used_lenses) | list %}
{% set vit = inspector_index['manifest://product'].vitals %}
{% set later = later_count if later_count is defined else summary.get('later', 0) %}
<noscript><style>.lens[hidden]{display:block}.tabs,.hdr-toggle,.dock,.sheet-head{display:none !important}header.top .vitals{display:flex !important}header.top .counts{display:block !important}.wb nav.tree,.wb .insp{position:static !important;visibility:visible !important;transform:none !important;max-height:none !important}</style></noscript>
{% if 'workbench' in shown_lenses %}<a class="skip-link" href="#model" data-skip="model">{{ 'Skip to the 3D view' if page_sections | selectattr('id', 'equalto', 'model') | list else 'Skip to the parts list' }}</a><a class="skip-link" href="#inspector" data-skip="inspector">Skip to the inspector</a>{% endif %}
<header class="top">
  <div class="row"><h1>{{ product.name }}</h1><span class="badge {{ stage_class }}">{{ stage_label }}</span><span class="muted rev">{{ revision_label }}</span><button type="button" class="hdr-toggle" aria-expanded="false" aria-controls="hdr-vitals hdr-counts">Details</button></div>
  <div class="row vitals" id="hdr-vitals">{% for key in ['total_mass', 'total_cost', 'envelope'] %}{% if vit.get(key) %}<span class="vital"><b>{{ vit[key].value }}</b> <span class="muted">{{ vit[key].label }}</span></span>{% endif %}{% endfor %}{% set oc = vit.get('open_choices') %}{% if oc %}<span class="vital"><a href="#waiting"><b>{{ oc.value }}</b></a></span>{% elif waiting %}<span class="vital"><a href="#waiting"><b>{{ waiting | length }} open choice{{ '' if waiting | length == 1 else 's' }}</b></a></span>{% else %}<span class="vital"><b>no open choices</b></span>{% endif %}</div>
  <div class="row muted counts" id="hdr-counts"><a href="#requirements">{{ summary.pass + summary.signed }} {{ w('pass') }}</a>{% if summary.fail %} · <a href="#requirements">{{ summary.fail }} {{ w('fail') }}</a>{% endif %}{% if summary['needs-human'] or not summary.example %} · <a href="#requirements">{{ summary['needs-human'] }} {{ w('needs-human') }}</a>{% endif %} · <a href="#requirements">{{ summary.warn }} {{ w('warn') }}</a> · <a href="#requirements">{{ summary.skip }} {{ w('skip') }}</a> · <a href="#requirements">{{ later }} {{ w('later') }}</a>{% if summary.example %} · <a href="#signoffs"><span class="example">{{ summary.example }} {{ w('example_one' if summary.example == 1 else 'example') }}</span></a>{% endif %}</div>
  <div class="tabs" role="tablist" aria-label="views of this product">{% for l in shown_lenses %}<button type="button" role="tab" id="tab-{{ l }}" data-lens-tab="{{ l }}" aria-controls="lens-{{ l }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ lens_label[l] }}</button>{% endfor %}</div>
</header>
<main>
{# One fragment per registered report section, in registry order (FOUNDATION F5): the
    mechanical sections are report/sections/*.html.j2; a domain's fragment lives in its own
    package and reads its own `data`.  Each sits in the panel of its registration's lens (V5). #}
{% for l in shown_lenses %}
<div class="lens" id="lens-{{ l }}" data-lens="{{ l }}" role="tabpanel" aria-labelledby="tab-{{ l }}"{% if not loop.first %} hidden{% endif %}>
{% if l == 'workbench' %}
<div class="wb" data-sheet="none">
  <nav class="tree" id="tree" aria-label="parts and objects"><div class="sheet-head"><span class="sheet-title">Parts</span><button type="button" class="sheet-close" data-sheet-close aria-label="Close the parts list">Close</button></div></nav>
  {% for s in page_sections if s.id == 'model' %}{% with data = section_data.get(s.id, {}) %}{% include s.template %}{% endwith %}{% endfor %}
  <aside class="insp" id="inspector" aria-label="inspector" tabindex="-1">
    <div class="sheet-head"><span class="sheet-title" id="inspector-sheet-title">{{ product.name }}</span><button type="button" class="sheet-close" data-sheet-close aria-label="Close the inspector">Close</button></div>
    <div id="inspector-head"><h2 id="inspector-title">{{ product.name }}</h2></div>
    <div id="inspector-product" class="product-view">{% for s in page_sections if s.id == 'overview' %}{% with data = section_data.get(s.id, {}) %}{% include s.template %}{% endwith %}{% endfor %}</div>
    <div id="inspector-entry" hidden></div>
  </aside>
  <div class="sr" id="inspector-status" role="status" aria-atomic="true"></div>
  {# the phone's dock (V8, S-324): three buttons above the tab bar; shown below 768 px only, by the CSS #}
  <div class="dock" role="group" aria-label="Panels">
    <button type="button" data-sheet-open="tree" aria-expanded="false" aria-controls="tree"><span class="lbl">Parts</span><span class="up" aria-hidden="true">▴</span></button>
    <button type="button" data-sheet-open="inspector" aria-expanded="false" aria-controls="inspector"><span class="lbl" id="dock-details">Product</span><span class="up" aria-hidden="true">▴</span></button>
    {% if glbs %}<button type="button" data-sheet-open="view" aria-expanded="false" aria-controls="view-panel"><span class="lbl">View</span><span class="up" aria-hidden="true">▴</span></button>{% endif %}
  </div>
</div>
{% endif %}
<div class="cards">
{% for s in page_sections if s.lens == l and not (l == 'workbench' and s.id in ['model', 'overview']) %}{% with data = section_data.get(s.id, {}) %}{% include s.template %}{% endwith %}

{% endfor %}</div>
</div>
{% endfor %}
<footer class="muted" style="font-size:.8rem">{{ n2f_mark }}generated by {{ n2f_wordmark }} {{ version }} · {{ generated }} · report {{ build_id }}</footer>
</main>
{# the sections on this page, in page order, for `n2f diff` (ecr/diff.py page_sections): the side index it read is gone (S-317) #}
{% set sec_ns = namespace(items=[]) %}{% for id, label, group in sections %}{% set sec_ns.items = sec_ns.items + [{'id': id, 'label': (label if id != 'changes' else words.changes)}] %}{% endfor %}<script type="application/json" id="report-sections">{{ sec_ns.items | tojson }}</script>
<script type="application/json" id="inspector-index">{{ inspector_json | safe }}</script>
{{ viewer_script | safe }}
</body>
</html>
