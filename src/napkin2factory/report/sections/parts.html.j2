<section class="card" id="parts">
  {{ h2('parts', 'Parts and cost') }}
  <p><strong>{{ rollups.total_cost | round(2) }} USD</strong> per unit from declared costs{% if not rollups.cost_complete %} <span class="badge warn">incomplete: some parts have no cost</span>{% endif %} · {{ (rollups.total_mass | round(3) ~ ' kg') | display }} · {{ rollups.part_count }} parts ({{ rollups.custom_count }} custom) · longest lead time {{ rollups.max_lead_time }} d</p>
  {% if cost_basis_line %}<p class="muted small">{{ cost_basis_line }}</p>{% endif %}
  <div class="scroll"><table id="bom"><caption class="sr">Parts and cost</caption><thead><tr><th scope="col">part</th><th scope="col">name</th><th scope="col" class="num">qty</th><th scope="col">made or bought</th><th scope="col" class="num">unit cost</th><th scope="col" class="num">total</th><th scope="col">sourcing</th><th scope="col">what to tell the manufacturer</th><th scope="col">see</th></tr></thead><tbody>
  {% for ln in bom_lines %}<tr data-uri="{{ ln.uri }}"{% if ln.anchor %} id="part-{{ ln.id }}"{% endif %}><td class="mono">{{ ('&nbsp;&nbsp;' * ln.level) | safe }}{{ ln.uri | disp }}</td><td>{{ ln.name }}</td><td class="num">{{ ln.total_qty }}</td><td>{{ 'bought' if ln.kind == 'cots' else ln.kind }}</td><td class="num">{{ '%.2f' % ln.unit_cost if ln.unit_cost is not none else '—' }}{% if ln.cost_note_no %}<sup>{{ ln.cost_note_no }}</sup>{% endif %}</td><td class="num">{{ '%.2f' % ln.ext_cost if ln.ext_cost is not none else '—' }}</td><td>{% if ln.kind == 'cots' %}<span class="badge {{ 'ok' if ln.sourcing_status == 'verified' else 'warn' if ln.sourcing_status in ('unverified','catalog','no-url','link-failed') else 'fail' if ln.sourcing_status == 'missing' else 'skip' }}">{{ ln.sourcing_status }}</span>{% else %}custom{% endif %}</td><td>{{ ln.manufacturer }}</td><td class="actions small">{% if glb_b64 %}<a href="#model" data-show3d="{{ ln.uri }}">3D</a>{% endif %}{% if ln.has_drawing %}<a href="#drawing-{{ ln.id }}">drawing</a>{% endif %}</td></tr>{% endfor %}
  </tbody></table></div>
  {% if cost_notes %}<ol class="muted small" id="cost-notes">{% for n in cost_notes %}<li>{{ n }}</li>{% endfor %}</ol>{% endif %}
  <p class="muted small">Prices are declared estimates until a shop quotes them. Spreadsheet: <span class="mono">build/bom/bom.xlsx</span>, <span class="mono">build/bom/bom.csv</span>.</p>
</section>
