<section class="card" id="drawings">
  {{ h2('drawings', 'Drawings') }}
  <p class="lead">Each drawing fits the page; zoom with the buttons, ctrl and the wheel, or a pinch, and drag to move it. The full-size files are in <span class="mono">build/drawings/</span>.</p>
  {% if drawings %}<div class="grid">{% for d in drawings %}<figure id="drawing-{{ d.id }}"><div class="pz" data-panzoom><div class="pz-bar"><button type="button" data-pz="in" aria-label="Zoom in">+ Zoom in</button><button type="button" data-pz="out" aria-label="Zoom out">&minus; Zoom out</button><button type="button" data-pz="fit" aria-label="Reset to fit the width">Reset</button><button type="button" data-pz="full" aria-label="Full screen" aria-pressed="false">Full screen</button></div><div class="pz-view" role="group" tabindex="0" aria-label="Drawing of {{ d.uri }}: arrow keys move, plus and minus zoom, 0 fits"><div class="pz-stage">{{ d.svg | safe }}</div></div></div><figcaption>{{ d.uri | ref }} · rev {{ d.rev }}{% if d.has_flat %} · flat pattern: <span class="mono">build/drawings/{{ d.id }}-flat.dxf</span>{% endif %}{% if glb_b64 %} · <a href="#model" data-show3d="{{ d.uri }}">3D</a>{% endif %}</figcaption></figure>{% endfor %}</div>{% else %}<p class="muted">No drawings yet.</p>{% endif %}
</section>
