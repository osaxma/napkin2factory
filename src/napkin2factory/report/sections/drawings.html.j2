<section class="card" id="drawings">
  {{ h2('drawings', 'Drawings') }}
  <p class="lead">Click a drawing to open it full screen, where you can zoom, move it and switch to another drawing. The full-size files are in <span class="mono">build/drawings/</span>.</p>
  {% if drawings %}<div class="grid">{% for d in drawings %}<figure id="drawing-{{ d.id }}"><div class="pz-card" data-pzcard data-title="{{ d.name }}"><button type="button" class="pz-open" aria-label="Open {{ d.name }} drawing">{{ d.svg | safe }}</button></div><figcaption>{% if persona == 'engineer' %}{{ d.uri | ref }}{% else %}{{ d.name }}{% endif %} · rev {{ d.rev }}{% if d.has_flat %} · flat pattern: <span class="mono">build/drawings/{{ d.id }}-flat.dxf</span>{% endif %}{% if glb_b64 %} · <a href="#model" data-show3d="{{ d.uri }}">3D</a>{% endif %}</figcaption></figure>{% endfor %}</div>{% else %}<p class="muted">No drawings yet.</p>{% endif %}
</section>
