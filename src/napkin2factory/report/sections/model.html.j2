<section class="card" id="model">
  {{ h2('model', '3D model') }}
  {% if glbs %}
  {% for g in glbs %}
  {% set v_id = "viewer" if loop.first else "viewer-" ~ g.id %}
  {% set d_id = "glb-data" if loop.first else "glb-data-" ~ g.id %}
  {% set g_ex = g.exploded if g.exploded is defined else exploded %}
  <div id="{{ v_id }}" data-n2f-glb="{{ d_id }}" data-explode-axis="{{ g_ex.axis }}" data-explode-spacing="{{ g_ex.spacing }}"{% if viewer_options %} data-n2f-options="{{ viewer_options }}"{% endif %}></div>
  <script type="text/plain" id="{{ d_id }}">{{ g.b64 }}</script>
  {% endfor %}
  <div class="viewer-bar">
    <label>Explode <input id="explode" type="range" min="0" max="1" step="0.01" value="0"></label>
    <label><input id="section" type="checkbox"> Section cut</label>
    <select id="section-axis" aria-label="Section axis"><option value="x">X</option><option value="y">Y</option><option value="z" selected>Z</option></select>
    <input id="section-offset" type="range" min="0" max="1" step="0.01" value="0.5" aria-label="Section offset">
    <button id="fit" type="button">Fit</button>
    <button id="show-all" type="button" aria-label="Show all parts">Show all</button>
    <span class="muted">click a part to see its details · double-click to isolate it · drag to orbit · click the model, then scroll to zoom</span>
  </div>
  <div id="part-card" class="muted">Click a part.</div>
  {% else %}<p class="muted">No assembly geometry to show.</p>{% endif %}
  {% if renders %}<h3>Rendered views</h3>
  <div class="grid">{% for r in renders %}<figure><img src="data:image/png;base64,{{ r.b64 }}" alt="{{ r.label | disp }}" style="width:100%"><figcaption>{{ r.label | disp | replace('asm://', '') | replace(' · iso', ' — from the corner') | replace(' · section', ' — cut through the middle') }}</figcaption></figure>{% endfor %}</div>{% endif %}
</section>
