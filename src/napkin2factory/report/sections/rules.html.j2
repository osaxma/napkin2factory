<section class="card" id="rules">
  {{ h2('rules', 'Rule checks') }}
  <p class="lead">Design rules run against every part (sheet-metal limits, sourcing, completeness) plus assembly-level checks. {{ rule_summary.pass }} {{ w('pass') }}{% if rule_summary.warn %} · {{ rule_summary.warn }} {{ w('warn') }}{% endif %}{% if rule_summary.fail %} · {{ rule_summary.fail }} {{ w('fail') }}{% endif %}{% if rule_summary.skip %} · {{ rule_summary.skip }} {{ w('skip') }}{% endif %}.</p>
  {% if module_groups %}<h3>By module</h3>
  <p class="small muted">Each unit is checked on its own; a joint between units is checked with the unit both sides are built into. These counts take every check row of the unit, the rules on each of its parts and its sourcing included, so they are larger than a build step's.</p>
  <table class="modules"><caption class="sr">Checks by module</caption><thead><tr><th scope="col">module</th><th scope="col" class="num">{{ w('pass') }}</th><th scope="col" class="num">{{ w('warn') }}</th><th scope="col" class="num">{{ w('fail') }}</th><th scope="col" class="num">{{ w('skip') }}</th></tr></thead><tbody>{% for g in module_groups %}<tr><td>{{ g.title }}</td><td class="num">{{ g.summary.get('pass', 0) + g.summary.get('signed', 0) }}</td><td class="num">{{ g.summary.get('warn', 0) }}</td><td class="num">{{ g.summary.get('fail', 0) }}</td><td class="num">{{ g.summary.get('skip', 0) + g.summary.get('needs-human', 0) }}</td></tr>{% endfor %}</tbody></table>{% endif %}
  {% if other_rows %}<h3>Findings ({{ other_rows | length }})</h3>
  <div class="scroll"><table><caption class="sr">Rule findings</caption><thead><tr><th scope="col">check</th><th scope="col">subject</th><th scope="col">status</th><th scope="col">detail</th></tr></thead>{% for grp in other_groups %}<tbody>{% if grp.title %}<tr class="module"><th colspan="4" scope="colgroup">{{ grp.title }}</th></tr>{% endif %}{% for r in grp.rows %}<tr><td class="mono">{{ r.id | replace('rule://', '') }}</td><td>{{ r.subject | ref }}</td><td>{{ badge(r.status) }}</td><td>{{ r.message }}</td></tr>{% endfor %}</tbody>{% endfor %}</table></div>
  {% else %}<p>Every rule passes.</p>{% endif %}
  {% if rule_matrix.rules %}<h3>Rules × parts</h3>
  <div class="legend"><span><i class="dot pass" aria-hidden="true"></i> {{ w('pass') }}</span><span><i class="dot warn" aria-hidden="true"></i> {{ w('warn') }}</span><span><i class="dot fail" aria-hidden="true"></i> {{ w('fail') }}</span><span><i class="dot skip" aria-hidden="true"></i> {{ w('skip') }}</span><span>blank: rule does not apply</span></div>
  <div class="scroll"><table class="matrix"><caption class="sr">Rules by part: the status of each rule on each part</caption><thead>{% if rule_matrix.groups %}<tr><th class="rule" scope="col"><span class="sr">rule group</span></th>{% for g in rule_matrix.groups %}<th scope="colgroup" class="module" colspan="{{ g.span }}">{{ g.title }}</th>{% endfor %}</tr>{% endif %}<tr><th scope="col" class="rule">rule</th>{% for p in rule_matrix.parts %}<th scope="col" class="part"><a href="#part-{{ p }}">{{ p }}</a></th>{% endfor %}</tr></thead><tbody>
  {% for rid, title in rule_matrix.rules.items() %}<tr><th scope="row" class="rule" title="{{ rid }}">{{ title }}</th>{% for p in rule_matrix.parts %}{% set st = rule_matrix.cells.get(p, {}).get(rid) %}<td class="cell">{% if st %}<i class="dot {{ st }}" title="{{ p }}: {{ w(st) }}"><span class="sr">{{ w(st) }}</span></i>{% endif %}</td>{% endfor %}</tr>{% endfor %}
  </tbody></table></div>{% endif %}
</section>
