<section class="card" id="signoffs">
  {{ h2('signoffs', 'Sign-offs') }}
  <p class="lead">A sign-off is a human's statement that a requirement checked by hand holds. It is bound to the evidence at signing time and lapses when that evidence changes.</p>
  {% if signoffs %}<table><caption class="sr">Sign-offs</caption><thead><tr><th scope="col">requirement</th><th scope="col">by</th><th scope="col">date</th><th scope="col">statement</th><th scope="col">valid</th></tr></thead><tbody>{% for s in signoffs %}<tr id="signoff-{{ s.requirement | replace('req://', '') }}"><td>{{ s.requirement | ref }}</td><td>{{ s.by }}{% if s.example %} <span class="example">EXAMPLE SIGN-OFF, NOT A REVIEW</span>{% endif %}</td><td>{{ s.date }}</td><td>{{ s.statement }}</td><td><span class="badge {{ 'ok' if s.valid else 'warn' }}">{{ 'valid' if s.valid else s.why }}</span></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">None yet.</p>{% endif %}
</section>
